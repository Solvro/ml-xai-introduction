# Copy to .env and fill in values (never commit .env).
# Loaded automatically at train startup via python-dotenv.

# Weights & Biases (when logging=wandb)
WANDB_API_KEY=
WANDB_ENTITY=
# WANDB_PROJECT=  # optional; defaults from conf/logging/

# MLflow (when logging=mlflow)
MLFLOW_TRACKING_URI=file:./mlruns

# TensorBoard writes to outputs/ — no secrets required.
